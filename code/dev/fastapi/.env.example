# Local development environment template.
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is the tracked,
# secret-free version of the same settings.
#
#   cp .env.example .env
#
# These are the same values as the defaults in app/db.py, so a developer who
# never copies this file still boots. It exists so the settings are written
# down instead of assumed, and so DATABASE_URL is explicit.

# --- database --------------------------------------------------------------
# The app is async; the driver is part of the URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/cservice

# Optional read replica. Unset means the primary is used, so nothing has to
# know whether a replica exists.
# DB_READ_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/cservice

# Pool tuning. All optional; see app/db.py for the defaults.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_ECHO=false

# --- identity --------------------------------------------------------------
# MUST be overridden outside local development. app/security.py rejects the
# shipped development default when CSERVICE_ENV is anything but "development".
SECRET_KEY=local-dev-only-signing-key-do-not-use-in-production

# --- environment -----------------------------------------------------------
APP_ENV=development
ENV=development
CSERVICE_ENV=development

# CORS origins (comma separated).
# CSERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- optional background workers -------------------------------------------
# ALL default to OFF so a local boot has no background thread mutating data
# while a developer is looking at it. Enable one deliberately.
CSERVICE_PARTITION_WORKER=0
CSERVICE_AUTO_RECOVERY=0
CSERVICE_PIPELINE_AUTOSTART=0
CSERVICE_CANARY_AUTOPROMOTE=0

# --- shadow environment ----------------------------------------------------
# A second process that runs changed code against replicated live data, where
# the impact on live is structurally impossible rather than merely intended.
# `python3 scripts/run_shadow_env.py` reports the isolation verdict; six checks
# decide it and every one of them fails closed when unconfigured.
#
# Deliberately NO fallback to DATABASE_URL. A shadow that inherited live's url
# by default would be a live deployment wearing a shadow's name, and the only
# defence would be a convention somebody remembers. An unset value reads as
# "unconfigured" and fails the guard.
# CSERVICE_SHADOW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/cservice_shadow

# The shadow's CSERVICE_ENV must be shadow, not live -- checked by
# `environment_marker`, because a process that believes it is live will not
# behave like a shadow whatever its database points at.
# CSERVICE_ENV=shadow

# Every writable target the shadow declares. Must contain no live target.
# CSERVICE_SHADOW_WRITE_TARGETS=shadow_database

# Whether the live replication role is read-only. Declare it, because
# "live is read-only" is a property of the credential and not of a config value.
# CSERVICE_LIVE_READ_ONLY_REPLICATION=1

# host:port the shadow may reach outbound. Empty means unconfigured, which fails
# closed -- an unconstrained egress is not an isolated network.
# CSERVICE_SHADOW_EGRESS_ALLOWLIST=127.0.0.1:5432

# Where the flow simulation appends its findings. Defaults to BLOCKAGES.md
# beside the repo root.
# CSERVICE_BLOCKAGES_PATH=/path/to/BLOCKAGES.md

# --- the self-check (optional) ------------------------------------------------
# One command runs everything: flows, completeness, shadow isolation,
# authorization and the promotion gates.
#
#   python3 scripts/run_kaizen.py
#   python3 scripts/run_kaizen.py --level l4_live --json
#   python3 scripts/run_kaizen.py --daemon          # same thing on a loop
#
# Off by default, like the three workers above. It costs 21 flow simulations,
# twelve module resolutions and a walk of every served route, so a developer boot
# should not pay for it unasked.
# CSERVICE_KAIZEN_AUTORUN=0

# Seconds between scheduled sweeps. Generous on purpose -- a sweep is CPU-bound
# and there is no value in re-deciding on a loop tight enough to show up in a
# profile. The first sweep runs *immediately* on start, not after this interval.
# CSERVICE_KAIZEN_INTERVAL=900

# Whether the scheduled sweep may write to BLOCKAGES.md. Off by default: an
# automatic writer fills the log with dated sections nobody wrote, and the
# duplicate-section guard would refuse every one of them, so it is either a
# no-op or a flood. Appends stay a person's decision --
# `python3 scripts/run_kaizen.py --append`.
# CSERVICE_KAIZEN_APPEND=0

# Named on the ladder entry the sweep records, so a gate report says who asked.
# CSERVICE_KAIZEN_MAINTAINER=sweep

# --- external enrichment ---------------------------------------------------
# Calls real third-party HTTP APIs. Off by default.
ENRICHMENT_ENABLED=0

# Per-provider webhook secrets, one per entry in WEBHOOK_PROVIDERS. Absent
# secrets make that provider reject every push with 401, which is the
# intended fail-closed behaviour.
# WEBHOOK_SECRET_KYC=
# WEBHOOK_SECRET_FIRMO=
# WEBHOOK_SECRET_FX=
# WEBHOOK_SECRET_WEATHER=
# WEBHOOK_SECRET_SHIPPING=

# --- device recognition ----------------------------------------------------
# How much of a recognition verdict is acted on. See
# app/services/device_recognition.py for why this is not a constant.
#
#   off       -- nothing is computed
#   advisory  -- the verdict is computed, recorded and returned; it does not
#                change what a login requires. THE DEFAULT, deliberately:
#                enabling an unconfigured feature that changes who can sign in
#                is not a default worth shipping.
#   enforced  -- the verdict chooses which credential a login must present,
#                except where the account has not enrolled the one it calls
#                for. That exception is not optional: without it, a
#                password-only customer signing in from a new device is told
#                to produce a second factor they never enrolled, and the only
#                way past it is to be logged in.
#
# An unrecognised value falls back to advisory, not off -- a typo'd `enforced`
# that silently ran `off` would look configured and be inert.
# CSERVICE_RECOGNITION_MODE=advisory

# Pepper for the recognition signal digests. Without one the digests are still
# HMAC'd and domain-separated, but a database-only compromise is easier to
# correlate across deployments. Leave unset and you get a shared default, which
# is better than a per-process random value: that would make devices
# unrecognisable after every restart.
# CSERVICE_RECOGNITION_PEPPER=

# --- outbound mail ---------------------------------------------------------
# Transport for the one-time codes. The default cannot deliver, and the OTP
# endpoint says so in its response rather than claiming a code is on its way:
#
#   simulated -- (default) records the message in a bounded in-memory outbox
#                and sends nothing. Exists so the OTP path works end to end
#                without a mail server.
#   file      -- writes each message as JSON under CSERVICE_MAIL_DIR. For a
#                staging box, and for reading the code during development.
#   smtp      -- a real send.
#
# An unrecognised value falls back to `simulated` rather than to something that
# might claim delivery.
# CSERVICE_MAIL_TRANSPORT=simulated

# Where the `file` transport writes. Ignored by the other two.
# CSERVICE_MAIL_DIR=./var/mail

# SMTP settings, used only when CSERVICE_MAIL_TRANSPORT=smtp. CSERVICE_SMTP_HOST
# unset means every send fails loudly rather than hanging on connect.
# CSERVICE_SMTP_HOST=
# CSERVICE_SMTP_PORT=587
# CSERVICE_SMTP_USER=
# CSERVICE_SMTP_PASSWORD=
# CSERVICE_SMTP_FROM=
# CSERVICE_SMTP_TLS=1

# --- connected storage -----------------------------------------------------
# Where the OAuth callback comes back to. Required to connect anything: the
# redirect URI is never derived from the request, because a redirect built from
# a client-supplied Host is a redirect the client chooses. Unset means the
# connect endpoint answers 503 rather than sending someone to a URL that will
# not match what is registered with the provider.
# CSERVICE_STORAGE_REDIRECT_URI=https://your-host/users/me/storage/callback

# Provider credentials, one pair per entry in STORAGE_PROVIDERS. Absent values
# make that provider report `configured: false`, which is what stops the UI
# offering a button that leads to a broken consent screen.
#
# Credentials alone are not sufficient: the callback also needs the redirect URI
# above and an outbound HTTP transport installed by the deployment
# (`app.routers.identity.set_transport_hook`). Without all three a connection
# stays `pending` with the reason on the row. `/meta/ecosystem` reports the three
# conditions together as `storage_providers.can_complete`.
#
# The exchange never fabricates a token to make a connection look live.
# STORAGE_GOOGLE_DRIVE_CLIENT_ID=
# STORAGE_GOOGLE_DRIVE_CLIENT_SECRET=
# STORAGE_DROPBOX_CLIENT_ID=
# STORAGE_DROPBOX_CLIENT_SECRET=
# STORAGE_ONEDRIVE_CLIENT_ID=
# STORAGE_ONEDRIVE_CLIENT_SECRET=
