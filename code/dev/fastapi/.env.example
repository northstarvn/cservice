# Local development environment template.
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is the tracked,
# secret-free version of the same settings.
#
#   cp .env.example .env
#
# These are the same values as the defaults in app/db.py, so a developer who
# never copies this file still boots. It exists so the settings are written
# down instead of assumed, and so DATABASE_URL is explicit.

# --- database --------------------------------------------------------------
# The app is async; the driver is part of the URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/cservice

# Optional read replica. Unset means the primary is used, so nothing has to
# know whether a replica exists.
# DB_READ_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/cservice

# Pool tuning. All optional; see app/db.py for the defaults.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_ECHO=false

# --- identity --------------------------------------------------------------
# MUST be overridden outside local development. app/security.py rejects the
# shipped development default when CSERVICE_ENV is anything but "development".
SECRET_KEY=local-dev-only-signing-key-do-not-use-in-production

# --- environment -----------------------------------------------------------
APP_ENV=development
ENV=development
CSERVICE_ENV=development

# CORS origins (comma separated).
# CSERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- optional background workers -------------------------------------------
# ALL default to OFF so a local boot has no background thread mutating data
# while a developer is looking at it. Enable one deliberately.
CSERVICE_PARTITION_WORKER=0
CSERVICE_AUTO_RECOVERY=0
CSERVICE_PIPELINE_AUTOSTART=0
CSERVICE_CANARY_AUTOPROMOTE=0

# --- shadow environment ----------------------------------------------------
# A second process that runs changed code against replicated live data, where
# the impact on live is structurally impossible rather than merely intended.
# `python3 scripts/run_shadow_env.py` reports the isolation verdict; six checks
# decide it and every one of them fails closed when unconfigured.
#
# Deliberately NO fallback to DATABASE_URL. A shadow that inherited live's url
# by default would be a live deployment wearing a shadow's name, and the only
# defence would be a convention somebody remembers. An unset value reads as
# "unconfigured" and fails the guard.
# CSERVICE_SHADOW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/cservice_shadow

# The shadow's CSERVICE_ENV must be shadow, not live -- checked by
# `environment_marker`, because a process that believes it is live will not
# behave like a shadow whatever its database points at.
# CSERVICE_ENV=shadow

# Every writable target the shadow declares. Must contain no live target.
# CSERVICE_SHADOW_WRITE_TARGETS=shadow_database

# Whether the live replication role is read-only. Declare it, because
# "live is read-only" is a property of the credential and not of a config value.
# CSERVICE_LIVE_READ_ONLY_REPLICATION=1

# host:port the shadow may reach outbound. Empty means unconfigured, which fails
# closed -- an unconstrained egress is not an isolated network.
# CSERVICE_SHADOW_EGRESS_ALLOWLIST=127.0.0.1:5432

# Where the flow simulation appends its findings. Defaults to BLOCKAGES.md
# beside the repo root.
# CSERVICE_BLOCKAGES_PATH=/path/to/BLOCKAGES.md

# --- external enrichment ---------------------------------------------------
# Calls real third-party HTTP APIs. Off by default.
ENRICHMENT_ENABLED=0

# Per-provider webhook secrets, one per entry in WEBHOOK_PROVIDERS. Absent
# secrets make that provider reject every push with 401, which is the
# intended fail-closed behaviour.
# WEBHOOK_SECRET_KYC=
# WEBHOOK_SECRET_FIRMO=
# WEBHOOK_SECRET_FX=
# WEBHOOK_SECRET_WEATHER=
# WEBHOOK_SECRET_SHIPPING=
