{
  "ai_chat": {
    "id": "ai_chat_module",
    "description": "Backend-backed AI assistant for customer support, retention analysis, and loyalty improvement.",
    "backend_integration": {
      "endpoint": "/chat",
      "methods": [
        {
          "id": "send_message",
          "method": "POST",
          "url": "/chat",
          "payload": {
            "message": "string"
          },
          "response": {
            "text": "string",
            "sentiment": {
              "label": "string",
              "score": "float"
            },
            "suggestions": ["string"],
            "vector": ["float"],
            "insights": ["object"],
            "summary": "object",
            "improvement_pack": "object"
          }
        },
        {
          "id": "chat_history",
          "method": "GET",
          "url": "/chat/history"
        },
        {
          "id": "chat_insights",
          "method": "GET",
          "url": "/chat/insights"
        },
        {
          "id": "interaction_signals",
          "method": "GET",
          "url": "/chat/signals"
        },
        {
          "id": "system_priorities",
          "method": "GET",
          "url": "/chat/system-priorities"
        },
        {
          "id": "interaction_trends",
          "method": "GET",
          "url": "/chat/trends"
        },
        {
          "id": "retention_cohorts",
          "method": "GET",
          "url": "/chat/retention-cohorts"
        },
        {
          "id": "churn_prediction",
          "method": "GET",
          "url": "/chat/churn-prediction"
        },
        {
          "id": "lifecycle_stages",
          "method": "GET",
          "url": "/chat/lifecycle-stages"
        },
        {
          "id": "improvement_pack",
          "method": "GET",
          "url": "/chat/improvement-pack"
        },
        {
          "id": "retention_snapshots",
          "method": "GET",
          "url": "/chat/snapshots"
        },
        {
          "id": "retention_snapshot_delta",
          "method": "GET",
          "url": "/chat/snapshots/delta"
        }
      ]
    },
    "backend_notes": [
      "Keep existing chat history storage intact.",
      "Preserve additive retention analytics behavior.",
      "Do not disable auth, bookings, or chat response flow.",
      "Snapshot persistence is stored in the FastAPI backend database."
    ]
  }
}
